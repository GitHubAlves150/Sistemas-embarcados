# ESP-IDF: pasta de build (gerada a cada compilação, pode ter vários GB acumulados)
build/

# ESP-IDF: cache de sdkconfig gerado automaticamente (mantenha o sdkconfig.defaults, não este)
sdkconfig.old

# Logs do idf.py monitor / build
*.log
log/

# Arquivos de dependências baixadas pelo gerenciador de componentes
managed_components/
dependencies.lock

# VSCode (config pessoal, não do projeto)
.vscode/

# Python
__pycache__/
*.pyc

# Sistema
.DS_Store
Thumbs.db